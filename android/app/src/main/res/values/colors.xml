<?xml version="1.0" encoding="utf-8"?>
<!-- Roop palette. Values are the specification's starting points. -->
<resources>
    <color name="canvas">#F5F8FF</color>
    <color name="canvas_cool">#EEF4FF</color>

    <color name="surface">#EBFFFFFF</color>
    <color name="surface_solid">#FFFFFF</color>
    <color name="surface_soft">#F2F6FF</color>
    <color name="surface_selected">#E2EBFF</color>

    <color name="ink">#11172B</color>
    <color name="ink_secondary">#536181</color>
    <color name="ink_muted">#7D89A8</color>

    <color name="border">#FFFFFF</color>
    <color name="border_cool">#D8E2F5</color>

    <color name="blue">#1677FF</color>
    <color name="cyan">#12C8F5</color>
    <color name="violet">#7955F7</color>
    <color name="lavender">#E9E4FF</color>

    <color name="success">#149B76</color>
    <color name="warning">#B97712</color>
    <color name="danger">#C93B52</color>

    <color name="shadow_tint">#B7C9EE</color>

    <!-- Gradient stops, named separately so drawables stay readable. -->
    <color name="grad_start">#12C8F5</color>
    <color name="grad_mid">#1677FF</color>
    <color name="grad_end">#8055F7</color>

    <!-- Scrim behind labels that sit on top of thumbnails. -->
    <color name="scrim">#8C0A0F1F</color>
    <color name="crown_fill">#FFF8E8</color>
    <color name="crown_border">#F4E4BD</color>
</resources>
